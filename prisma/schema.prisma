generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Precio editable por alojamiento (se administra desde el panel).
// El resto del contenido del alojamiento (fotos, descripciones, etc.) vive en
// src/lib/alojamiento.ts. Acá solo guardamos el precio, que es lo que cambia.
// precioARS = null significa "Consultar".
model AlojamientoPrecio {
  slug          String   @id
  precioARS     Int?
  actualizadoEn DateTime @updatedAt @default(now())
}

model Reserva {
  id              String   @id @default(cuid())
  creadoEn        DateTime @default(now())
  nombre          String
  apellido        String
  email           String
  telefono        String
  dni             String
  checkIn         DateTime
  checkOut        DateTime
  tipoAlojamiento String   // "dorm" | "privada" | "departamento"
  cantPersonas    Int
  huespedes       Json     // { nombre: string, apellido: string }[]
  creadaPorAdmin  Boolean  @default(false)
  montoTotal      Float?
  montoPagado     Float    @default(0)
  pagos           Json     @default("[]") // { fecha: string, monto: number, nota?: string }[]
}
